(ns kotoba.zap-proxy.plugin-entry
  "Host-side entry for the hermes-zap-proxy plugin.

  Reads one EDN request map on stdin:
    {:target \"https://host/app\" :approval-id \"id\" :active? bool :max-pages N}

  Prints the report document (EDN) on stdout. The transport effect lives here
  (java.net.http); the approval record and path scope are checked before each
  request, and redirects are not followed."
  (:require [kotoba.lang.edn :as edn]
            [kotoba.zap-proxy.spider :as spider]
            [kotoba.zap-proxy.passive :as passive]
            [kotoba.zap-proxy.active :as active]
            [kotoba.zap-proxy.authorization :as authorization]
            [kotoba.zap-proxy.report :as report])
  (:import (java.net URI)
           (java.net.http HttpClient HttpClient$Redirect HttpRequest HttpRequest$BodyPublishers HttpResponse$BodyHandlers)))

(defn- java-fetch-fn
  "IHttp-equivalent transport over java.net.http. Returns the response map
  shape the decision core consumes. Every request is checked against the
  approval scope; redirects are returned, never followed."
  [approval-id mode max-pages initial-scope]
  (fn [{:keys [method url headers body]}]
    (when-not (or (nil? method) (= "GET" method))
      (throw (ex-info "Requested method is outside the approved scope." {:refused true})))
    (authorization/require-url! initial-scope url)
    (let [scope (authorization/authorization-scope approval-id url mode max-pages)
          _ (authorization/require-url! scope url)
          client (-> (HttpClient/newBuilder)
                     (.connectTimeout (java.time.Duration/ofSeconds 15))
                     (.followRedirects HttpClient$Redirect/NEVER)
                     (.build))
          builder (-> (HttpRequest/newBuilder (URI/create url))
                      (.timeout (java.time.Duration/ofSeconds 15))
                      (.GET))]
      (doseq [[k v] headers]
        (.header builder k (str v)))
      (when (and body (not= method "GET"))
        (.method builder (or method "POST")
                 (HttpRequest$BodyPublishers/ofString (str body))))
      (let [resp (.send client (.build builder)
                        (HttpResponse$BodyHandlers/ofInputStream))
            bytes (with-open [stream (.body resp)]
                    (.readNBytes stream 1048577))]
        (if (> (alength bytes) 1048576)
          {:status 0 :headers {} :body "response exceeded byte limit"}
          {:status (.statusCode resp)
           :headers (into {} (.map (.headers resp)))
           :body (String. bytes java.nio.charset.StandardCharsets/UTF_8)})))))

(defn -main [& _]
  (let [req (authorization/validate-production-request!
             (edn/read-string (java.lang.String. (.readAllBytes System/in))))
        {:keys [target active? max-pages approval-id]} req
        mode (if active? "active" "passive")
        scope (authorization/authorization-scope approval-id target mode (or max-pages 50))
        fetch-fn (java-fetch-fn approval-id mode (or max-pages 50) scope)
        crawl (spider/spider {:seed-url target
                              :fetch-fn fetch-fn
                              :max-pages (or max-pages 50)
                              :approval-id approval-id
                              :mode mode})
        pages (:pages crawl)
        passive-findings (vec (mapcat (fn [resp]
                                        (passive/passive-scan {:url (:url resp)} resp))
                                      pages))
        active-findings (if active?
                          (vec (mapcat (fn [resp]
                                         (active/active-scan {:url (:url resp)
                                                              :send-fn fetch-fn
                                                              :approval-id approval-id
                                                              :max-pages (or max-pages 50)}))
                                       pages))
                          [])
        findings (vec (concat passive-findings active-findings))
        doc (report/report-edn {:target target :findings findings :crawl crawl
                                :mode mode :max-pages (or max-pages 50)})]
    (if (= "json" (System/getenv "ZAP_PROXY_OUTPUT_FORMAT"))
      (println (report/report-json doc))
      (println (pr-str doc)))))
